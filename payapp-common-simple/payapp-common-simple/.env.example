# PayApp 설정 (https://payapp.kr > 설정 > 연동정보)
PAYAPP_USER_ID=your_payapp_id
PAYAPP_LINK_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
PAYAPP_LINK_VAL=xxxxxxxxxxxxxxxxxxxxxxxx

# HMAC 서명 비밀키 (권장: secrets.token_urlsafe(32))
PAYAPP_SECRET_KEY=replace_with_random_secret_at_least_32_chars

# PayApp 공통 통보 URL (PayApp 관리자 페이지에도 동일 값 등록)
PAYAPP_CALLBACK_URL=https://example.com/api/payment/callback
