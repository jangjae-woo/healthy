/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# cloudflare
.wrangler
.open-next

# claude code local settings (may contain secrets)
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*.local
182.json
185.jpeg

# video backups (pre-compression originals)
public/_video_backup/

# 아이기질과부모양육 generated cache data
# These files are kept locally under 아이기질브라덜, but are too large for GitHub.
아이기질브라덜/**/cache/**/*.jsonl
아이기질브라덜/**/cache/**/*.sqlite
아이기질브라덜/**/cache/**/index.json

# nested prototype dependencies
형과함께NEW/**/node_modules/
